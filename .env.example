# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: glovebox
AGENT_PROFILE=glovebox
# Which models: glovebox | budget | quality   (see src/models.py)
MODEL_PRESET=glovebox
# Optional: the LLM for the glovebox preset (default google/gemini-3.5-flash)
# GLOVEBOX_LLM=google/gemini-3.1-flash-lite
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent

# Driver phones, comma-separated, one variable per driver key in seed.yaml. Any
# other caller hears the privacy line. Kept here, never in seed.yaml or git.
GLOVEBOX_PHONES_MIKE=
GLOVEBOX_PHONES_DAVID=
# In `lk agent console` there's no caller ID, so
# pick who to be: a driver key from seed.yaml (default: the first, mike), or
# "stranger" to hear the privacy line.
# GLOVEBOX_TEST_CALLER=david
