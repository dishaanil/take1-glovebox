# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: glovebox
AGENT_PROFILE=glovebox
# Which models: glovebox | budget | quality   (see src/models.py)
MODEL_PRESET=glovebox
# Optional: the LLM for the glovebox preset (default google/gemini-3.5-flash)
# GLOVEBOX_LLM=google/gemini-3.1-flash-lite
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent
